terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
  }
}

provider "aws" {
  region = var.region
}

module "{{ module_name }}" {
  source  = "{{ namespace }}/{{ module_name }}/{{ provider }}"
  version = "{{ version_name }}"
  {%- for var in inputs %}
  {{ var.name }} = var.{{ var.name }}
  {%- endfor %}
}
