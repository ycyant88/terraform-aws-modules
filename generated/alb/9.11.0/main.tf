module "alb" {
  source                                                       = "terraform-aws-modules/alb/aws"
  version                                                      = "9.11.0"
  name_prefix                                                  = var.name_prefix
  security_group_ingress_rules                                 = var.security_group_ingress_rules
  enable_cross_zone_load_balancing                             = var.enable_cross_zone_load_balancing
  idle_timeout                                                 = var.idle_timeout
  enable_tls_version_and_cipher_suite_headers                  = var.enable_tls_version_and_cipher_suite_headers
  desync_mitigation_mode                                       = var.desync_mitigation_mode
  enforce_security_group_inbound_rules_on_private_link_traffic = var.enforce_security_group_inbound_rules_on_private_link_traffic
  default_protocol                                             = var.default_protocol
  security_group_name                                          = var.security_group_name
  load_balancer_type                                           = var.load_balancer_type
  name                                                         = var.name
  security_group_egress_rules                                  = var.security_group_egress_rules
  associate_web_acl                                            = var.associate_web_acl
  web_acl_arn                                                  = var.web_acl_arn
  subnet_mapping                                               = var.subnet_mapping
  tags                                                         = var.tags
  connection_logs                                              = var.connection_logs
  enable_deletion_protection                                   = var.enable_deletion_protection
  ip_address_type                                              = var.ip_address_type
  vpc_id                                                       = var.vpc_id
  route53_records                                              = var.route53_records
  putin_khuylo                                                 = var.putin_khuylo
  enable_waf_fail_open                                         = var.enable_waf_fail_open
  timeouts                                                     = var.timeouts
  additional_target_group_attachments                          = var.additional_target_group_attachments
  enable_http2                                                 = var.enable_http2
  access_logs                                                  = var.access_logs
  dns_record_client_routing_policy                             = var.dns_record_client_routing_policy
  internal                                                     = var.internal
  xff_header_processing_mode                                   = var.xff_header_processing_mode
  listeners                                                    = var.listeners
  create_security_group                                        = var.create_security_group
  security_group_use_name_prefix                               = var.security_group_use_name_prefix
  create                                                       = var.create
  customer_owned_ipv4_pool                                     = var.customer_owned_ipv4_pool
  preserve_host_header                                         = var.preserve_host_header
  security_groups                                              = var.security_groups
  default_port                                                 = var.default_port
  target_groups                                                = var.target_groups
  security_group_description                                   = var.security_group_description
  security_group_tags                                          = var.security_group_tags
  subnets                                                      = var.subnets
  client_keep_alive                                            = var.client_keep_alive
  drop_invalid_header_fields                                   = var.drop_invalid_header_fields
  enable_xff_client_port                                       = var.enable_xff_client_port
}
