module "ecs_container-definition" {
  source                                 = "terraform-aws-modules/ecs/aws//modules/container-definition"
  version                                = "5.12.0"
  operating_system_family                = var.operating_system_family
  environment                            = var.environment
  extra_hosts                            = var.extra_hosts
  image                                  = var.image
  port_mappings                          = var.port_mappings
  pseudo_terminal                        = var.pseudo_terminal
  working_directory                      = var.working_directory
  enable_cloudwatch_logging              = var.enable_cloudwatch_logging
  command                                = var.command
  dependencies                           = var.dependencies
  health_check                           = var.health_check
  memory_reservation                     = var.memory_reservation
  start_timeout                          = var.start_timeout
  docker_labels                          = var.docker_labels
  docker_security_options                = var.docker_security_options
  enable_execute_command                 = var.enable_execute_command
  interactive                            = var.interactive
  linux_parameters                       = var.linux_parameters
  resource_requirements                  = var.resource_requirements
  system_controls                        = var.system_controls
  volumes_from                           = var.volumes_from
  cloudwatch_log_group_retention_in_days = var.cloudwatch_log_group_retention_in_days
  hostname                               = var.hostname
  links                                  = var.links
  privileged                             = var.privileged
  cloudwatch_log_group_name              = var.cloudwatch_log_group_name
  cloudwatch_log_group_use_name_prefix   = var.cloudwatch_log_group_use_name_prefix
  cpu                                    = var.cpu
  entrypoint                             = var.entrypoint
  essential                              = var.essential
  firelens_configuration                 = var.firelens_configuration
  name                                   = var.name
  secrets                                = var.secrets
  ulimits                                = var.ulimits
  dns_servers                            = var.dns_servers
  log_configuration                      = var.log_configuration
  readonly_root_filesystem               = var.readonly_root_filesystem
  stop_timeout                           = var.stop_timeout
  user                                   = var.user
  create_cloudwatch_log_group            = var.create_cloudwatch_log_group
  cloudwatch_log_group_kms_key_id        = var.cloudwatch_log_group_kms_key_id
  disable_networking                     = var.disable_networking
  dns_search_domains                     = var.dns_search_domains
  environment_files                      = var.environment_files
  memory                                 = var.memory
  mount_points                           = var.mount_points
  repository_credentials                 = var.repository_credentials
  service                                = var.service
  tags                                   = var.tags
}
