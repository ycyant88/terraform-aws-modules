  command                                = var.command
  dependsOn                              = var.dependsOn
  dnsServers                             = var.dnsServers
  extraHosts                             = var.extraHosts
  hostname                               = var.hostname
  enable_execute_command                 = var.enable_execute_command
  environmentFiles                       = var.environmentFiles
