module "app-runner" {
  source                                 = "terraform-aws-modules/app-runner/aws"
  version                                = "1.0.1"
  auto_scaling_configuration_arn         = var.auto_scaling_configuration_arn
  encryption_configuration               = var.encryption_configuration
  source_configuration                   = var.source_configuration
  instance_iam_role_description          = var.instance_iam_role_description
  enable_observability_configuration     = var.enable_observability_configuration
  observability_configuration            = var.observability_configuration
  create_instance_iam_role               = var.create_instance_iam_role
  vpc_connector_subnets                  = var.vpc_connector_subnets
  service_name                           = var.service_name
  instance_iam_role_permissions_boundary = var.instance_iam_role_permissions_boundary
  auto_scaling_configurations            = var.auto_scaling_configurations
  access_iam_role_use_name_prefix        = var.access_iam_role_use_name_prefix
  vpc_connector_name                     = var.vpc_connector_name
  health_check_configuration             = var.health_check_configuration
  network_configuration                  = var.network_configuration
  access_iam_role_description            = var.access_iam_role_description
  connections                            = var.connections
  tags                                   = var.tags
  create_service                         = var.create_service
  create_access_iam_role                 = var.create_access_iam_role
  access_iam_role_policies               = var.access_iam_role_policies
  instance_iam_role_name                 = var.instance_iam_role_name
  create_custom_domain_association       = var.create_custom_domain_association
  create_vpc_connector                   = var.create_vpc_connector
  instance_configuration                 = var.instance_configuration
  access_iam_role_name                   = var.access_iam_role_name
  access_iam_role_path                   = var.access_iam_role_path
  access_iam_role_permissions_boundary   = var.access_iam_role_permissions_boundary
  instance_iam_role_use_name_prefix      = var.instance_iam_role_use_name_prefix
  create                                 = var.create
  private_ecr_arn                        = var.private_ecr_arn
  instance_iam_role_path                 = var.instance_iam_role_path
  instance_iam_role_policies             = var.instance_iam_role_policies
  domain_name                            = var.domain_name
  enable_www_subdomain                   = var.enable_www_subdomain
  vpc_connector_security_groups          = var.vpc_connector_security_groups
}
