module "msk-kafka-cluster" {
  source                                               = "terraform-aws-modules/msk-kafka-cluster/aws"
  version                                              = "1.1.0"
  number_of_broker_nodes                               = var.number_of_broker_nodes
  broker_node_client_subnets                           = var.broker_node_client_subnets
  jmx_exporter_enabled                                 = var.jmx_exporter_enabled
  cloudwatch_logs_enabled                              = var.cloudwatch_logs_enabled
  s3_logs_prefix                                       = var.s3_logs_prefix
  cloudwatch_log_group_name                            = var.cloudwatch_log_group_name
  cloudwatch_log_group_retention_in_days               = var.cloudwatch_log_group_retention_in_days
  scaling_role_arn                                     = var.scaling_role_arn
  broker_node_security_groups                          = var.broker_node_security_groups
  firehose_logs_enabled                                = var.firehose_logs_enabled
  s3_logs_bucket                                       = var.s3_logs_bucket
  configuration_name                                   = var.configuration_name
  configuration_server_properties                      = var.configuration_server_properties
  schema_registries                                    = var.schema_registries
  create                                               = var.create
  broker_node_instance_type                            = var.broker_node_instance_type
  encryption_in_transit_client_broker                  = var.encryption_in_transit_client_broker
  encryption_in_transit_in_cluster                     = var.encryption_in_transit_in_cluster
  tags                                                 = var.tags
  create_cloudwatch_log_group                          = var.create_cloudwatch_log_group
  create_scram_secret_association                      = var.create_scram_secret_association
  name                                                 = var.name
  kafka_version                                        = var.kafka_version
  scaling_max_capacity                                 = var.scaling_max_capacity
  create_schema_registry                               = var.create_schema_registry
  broker_node_ebs_volume_size                          = var.broker_node_ebs_volume_size
  encryption_at_rest_kms_key_arn                       = var.encryption_at_rest_kms_key_arn
  cloudwatch_log_group_kms_key_id                      = var.cloudwatch_log_group_kms_key_id
  scram_secret_association_secret_arn_list             = var.scram_secret_association_secret_arn_list
  schemas                                              = var.schemas
  firehose_delivery_stream                             = var.firehose_delivery_stream
  s3_logs_enabled                                      = var.s3_logs_enabled
  timeouts                                             = var.timeouts
  configuration_description                            = var.configuration_description
  enhanced_monitoring                                  = var.enhanced_monitoring
  client_authentication_tls_certificate_authority_arns = var.client_authentication_tls_certificate_authority_arns
  node_exporter_enabled                                = var.node_exporter_enabled
  scaling_target_value                                 = var.scaling_target_value
  client_authentication_sasl_iam                       = var.client_authentication_sasl_iam
  client_authentication_sasl_scram                     = var.client_authentication_sasl_scram
}
